setEffect(CLAP,    VOLUME, GAIN, -6)
setEffect(HAT,     VOLUME, GAIN, -10)
setEffect(OPENHAT, VOLUME, GAIN, -12)
setEffect(GHOST,   VOLUME, GAIN, -16)
setEffect(LOOP,    VOLUME, GAIN, -12)
setEffect(FILL,    VOLUME, GAIN, -8)
setEffect(BASS,    VOLUME, GAIN, -4)
setEffect(RHODES,  VOLUME, GAIN, -6)
setEffect(WURLI,   VOLUME, GAIN, -9)
setEffect(PIANO,   VOLUME, GAIN, -6)
setEffect(PAD,     VOLUME, GAIN, -14)
setEffect(BRASS,   VOLUME, GAIN, -8)
setEffect(ANSWER,  VOLUME, GAIN, -10)
setEffect(TRUMPET, VOLUME, GAIN, -8)
setEffect(ARP,     VOLUME, GAIN, -12)
setEffect(GUITAR,  VOLUME, GAIN, -10)
setEffect(FX,      VOLUME, GAIN, -10)
