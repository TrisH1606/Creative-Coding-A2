# Stereo width
setEffect(RHODES,  PAN, LEFT_RIGHT, -30)
setEffect(WURLI,   PAN, LEFT_RIGHT, 30)
setEffect(GUITAR,  PAN, LEFT_RIGHT, -45)
setEffect(ARP,     PAN, LEFT_RIGHT, 40)
setEffect(OPENHAT, PAN, LEFT_RIGHT, 25)
setEffect(HAT,     PAN, LEFT_RIGHT, -20)

# Space: reverb and a dotted-eighth echo (128 BPM)
setEffect(PAD,     REVERB, REVERB_TIME, 2500)
setEffect(RHODES,  REVERB, REVERB_TIME, 900)
setEffect(TRUMPET, REVERB, REVERB_TIME, 1200)
setEffect(TRUMPET, DELAY, DELAY_TIME, 351)
setEffect(TRUMPET, DELAY, DELAY_FEEDBACK, -14)
setEffect(ARP,     DELAY, DELAY_TIME, 351)
setEffect(ARP,     DELAY, DELAY_FEEDBACK,-12)
